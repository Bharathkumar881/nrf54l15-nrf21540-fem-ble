
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    chosen {
        zephyr,console = &uart30;
        zephyr,shell-uart = &uart30;
    };

    /* nRF21540 FEM configuration */
    nrf_radio_fem: nrf21540_fem {
        compatible = "nordic,nrf21540-fem";

        /* FEM GPIO control */
        tx-en-gpios   = <&gpio1 8 GPIO_ACTIVE_HIGH>;
        rx-en-gpios   = <&gpio1 9 GPIO_ACTIVE_HIGH>;
        pdn-gpios     = <&gpio1 11 GPIO_ACTIVE_HIGH>;
        ant-sel-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;

        /* FEM SPI interface */
        spi-if = <&nrf_radio_fem_spi>;

        supply-voltage-mv = <3000>;

        tx-en-settle-time-us = <27>;
        rx-en-settle-time-us = <12>;
    };
};

/* Pin control configuration */
&pinctrl {

    /* UART30 */
    serial30_default: serial30_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 0)>;
        };

        group2 {
            psels = <NRF_PSEL(UART_RX, 0, 1)>;
            bias-pull-up;
        };
    };

    serial30_sleep: serial30_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 0)>,
                    <NRF_PSEL(UART_RX, 0, 1)>;
            low-power-enable;
        };
    };

    /* nRF21540 SPI21 */
    nrf21540_spi21_default: nrf21540_spi21_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 5)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 7)>;
        };
        /* Pull-down on MISO: with no nRF21540EK the line reads 0x00
         * instead of floating, so detection is predictable.
         */
        group2 {
            psels = <NRF_PSEL(SPIM_MISO, 1, 6)>;
            bias-pull-down;
        };
    };

    nrf21540_spi21_sleep: nrf21540_spi21_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 5)>,
                    <NRF_PSEL(SPIM_MISO, 1, 6)>,
                    <NRF_PSEL(SPIM_MOSI, 1, 7)>;
            low-power-enable;
        };
    };
};

/* Disable unused UART20 */
&uart20 {
    status = "disabled";
};

/* UART30 configuration */
&uart30 {
    status = "okay";
    current-speed = <115200>;

    pinctrl-0 = <&serial30_default>;
    pinctrl-1 = <&serial30_sleep>;
    pinctrl-names = "default", "sleep";
};

/* SPI21 configuration */
&spi21 {
    status = "okay";

    pinctrl-0 = <&nrf21540_spi21_default>;
    pinctrl-1 = <&nrf21540_spi21_sleep>;
    pinctrl-names = "default", "sleep";

    /* SPI Chip Select: P1.4 */
    cs-gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;

    nrf_radio_fem_spi: nrf21540_fem_spi@0 {
        compatible = "nordic,nrf21540-fem-spi";
        status = "okay";
        reg = <0>;
        spi-max-frequency = <8000000>;
    };
};

/* Connect FEM to radio */
&radio {
    fem = <&nrf_radio_fem>;
};

/* Enable DPPI peripherals */
&dppic10 {
    status = "okay";
};

&dppic20 {
    status = "okay";
};

&dppic30 {
    status = "okay";
};

/* Enable PPIB peripherals */
&ppib11 {
    status = "okay";
};

&ppib21 {
    status = "okay";
};

&ppib22 {
    status = "okay";
};

&ppib30 {
    status = "okay";
};
